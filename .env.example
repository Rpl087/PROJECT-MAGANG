APP_NAME="Arsip Surat BPSDMP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://kearsipan.local
APP_TIMEZONE=Asia/Makassar

# ── Konfigurasi Jaringan Intranet ────────────────────────────────────────────
# Set INTRANET_ENABLED=true untuk mengaktifkan pembatasan subnet (Intranet Production).
# Set INTRANET_ENABLED=false untuk mode development / akses bebas (localhost).
INTRANET_ENABLED=true

# Subnet WiFi Staff/Internal — IP dari range ini bisa akses semua fitur
INTERNAL_NETWORK_SUBNET=192.168.252.0/22

# Subnet WiFi Tamu — IP dari range ini hanya bisa akses halaman read-only (/tamu)
GUEST_NETWORK_SUBNET=10.0.0.0/24

GOOGLE_SHEET_ID=1QdlmA0ug3xNY2-3SIhCm4aj_3TsmWdmjerqmmR7AAKk
GOOGLE_SERVICE_ACCOUNT_JSON=storage/app/google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=12ocV7BcNlE-ZqruQtJ89-aE5QvZFk3Wn

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arsip_bpsdmp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
